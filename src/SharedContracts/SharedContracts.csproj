<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Ming Lu</Authors>
    <Version>1.0.12</Version>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Api.CommonProtos" GeneratePathProperty="true" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\aacState.proto" GrpcServices="None" AdditionalImportDirs="Protos;$(PkgGoogle_Api_CommonProtos)\content\protos" />
    <Protobuf Include="Protos\aac.proto" GrpcServices="Both" AdditionalImportDirs="Protos;$(PkgGoogle_Api_CommonProtos)\content\protos" />
    <Protobuf Include="Protos\greet.proto" GrpcServices="Both" AdditionalImportDirs="Protos;$(PkgGoogle_Api_CommonProtos)\content\protos" />
    <Content Include="Protos\**\*.proto">
      <Pack>true</Pack>
      <PackagePath>contentFiles\any\any\protos\</PackagePath>
      <PackageCopyToOutput>true</PackageCopyToOutput>
      <BuildAction>None</BuildAction>
    </Content>
  </ItemGroup>
</Project>